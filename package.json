{
  "name": "maze-game",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Maze Game — jogo de labirinto com captura de lead (core agnostico de engine)",
  "author": "GSB",
  "main": "shell/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts",
    "electron": "electron .",
    "dist": "npm run build && electron-builder",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && node scripts/build-android.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.4",
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
